{
  "name": "@gouv-cd/sdcd",
  "version": "0.9.3",
  "description": "Système de design RDC (SDCD) — identité numérique officielle des sites de l'État de la République Démocratique du Congo.",
  "license": "MIT",
  "author": "République Démocratique du Congo",
  "homepage": "https://systeme-de-design.gouv.cd",
  "type": "module",
  "main": "dist/sdcd.css",
  "style": "dist/sdcd.css",
  "exports": {
    ".": "./dist/sdcd.css",
    "./min": "./dist/sdcd.min.css",
    "./js": "./dist/sdcd.js",
    "./source": "./styles.css",
    "./tokens/*": "./tokens/*",
    "./assets/*": "./assets/*",
    "./components/*": "./components/*",
    "./jinja2": "./adaptateurs/jinja2/sdcd.html"
  },
  "files": [
    "dist/",
    "styles.css",
    "base.css",
    "components.css",
    "utilitaires.css",
    "responsive.css",
    "sdcd.js",
    "tokens/",
    "assets/",
    "components/",
    "guidelines/",
    "outils/",
    "readme.md",
    "LICENSE.md",
    "CHANGELOG.md",
    "adaptateurs/"
  ],
  "scripts": {
    "build": "node outils/construire.mjs",
    "test": "node outils/verifier-contraste.mjs",
    "verifier-contraste": "node outils/verifier-contraste.mjs",
    "prepublishOnly": "npm run build && npm test",
    "verifier-jinja2": "python adaptateurs/jinja2/verifier.py",
    "verifier-wordpress": "php adaptateurs/wordpress/verifier.php",
    "galerie": "python outils/galerie.py",
    "verifier-visuel": "node outils/verifier-visuel.mjs",
    "figer-visuel": "node outils/verifier-visuel.mjs --figer",
    "auditer": "node outils/auditer.mjs"
  },
  "keywords": [
    "design-system",
    "rdc",
    "gouv.cd",
    "sdcd",
    "accessibilite",
    "rgaa"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": [
    "*.css"
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
